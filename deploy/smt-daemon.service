[Unit]
Description=SMT Control System — Moxa NPort Adaptive Serial Daemon & IPC Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/smt-daemon 192.168.127.254 --ipc 127.0.0.1:7450
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
